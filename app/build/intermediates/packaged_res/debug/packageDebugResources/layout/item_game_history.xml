<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivGameMode"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Mode"
        android:src="@drawable/ic_rapid" />

    <TextView
        android:id="@+id/tvOpponentName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Nama_Lawan"
        android:textColor="#E8E8E8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvGameAccuracy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="87,5"
        android:textColor="#CCCCCC"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvResultBadge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_badge_plus"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+"
        android:textColor="#1B1B1B"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/btnAnalisa"
        android:layout_width="82dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_btn_analisa"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="Play"
            android:src="@drawable/ic_play_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Analisa"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

